# Set private values in the Vercel dashboard, never in the frontend repository.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOOX_IDENTITY_SECRET=
LOOX_ORIGINS=https://deadloxend-hash.github.io
LOOX_BACKEND_URL=https://looxtoolfree-backend.vercel.app
REPLICATE_API_TOKEN=
GEMINI_API_KEY=
# Existing GEMINI_API_KEY remains for free chat; older provider keys are not used for images.
LOOX_IMAGE_GOOGLE_API_KEY=
LOOX_IMAGE_BFL_API_KEY=
LOOX_IMAGE_IDEOGRAM_API_KEY=
LOOX_IMAGE_STABILITY_API_KEY=
LOOX_IMAGE_BYTEPLUS_API_KEY=
LOOX_IMAGE_OPENAI_API_KEY=
LOOX_IMAGE_REPLICATE_API_TOKEN=
# Comma-separated IDs only after paid smoke tests and pricing review.
LOOX_IMAGE_VERIFIED_MODELS=
# Comma-separated IDs blocked during an outage; takes priority over verified.
LOOX_IMAGE_SUSPENDED_MODELS=
REPLICATE_WEBHOOK_SIGNING_SECRET=
CRON_SECRET=
# Required positive integer in 1/1000 of a US cent. Example $5 = 500000.
LOOX_DAILY_BUDGET_MILLICENTS=
LOOX_USER_DAILY_JOBS=20
LEMON_API_KEY=
LEMON_STORE_ID=
LEMON_PRO_VARIANT=
LEMON_LIFETIME_VARIANT=
LEMON_WEBHOOK_SECRET=
# Use test only with a separate Supabase test project. Set live after acceptance tests.
LEMON_MODE=

# Optional GPU-offline FLUX.1 Schnell text-to-image fallback.
# Create a Cloudflare account-scoped API token with Workers AI Read only.
# Keep both values in private Vercel Production environment variables.
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# Safety: fallback has a hardcoded global cap of 100 requests per UTC day,
# besides Cloudflare's account-shared Workers AI allowance. Local GPU wins.

# Billing launch gates. Leave disabled until explicit live-billing approval.
ANNUAL_BILLING_ENABLED=false
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=lemonsqueezy
CREDIT_TOPUPS_ENABLED=false
TOPUP_MARGIN_APPROVED=false
LEMON_CREATOR_VARIANT=
LEMON_BUSINESS_VARIANT=
LEMON_CREATOR_YEARLY_VARIANT=
LEMON_PRO_YEARLY_VARIANT=
LEMON_BUSINESS_YEARLY_VARIANT=
# Transactional mail (verified sender domain required). Recipient can be Gmail.
SECURITY_ALERT_EMAIL=
SECURITY_ALERT_FROM=
RESEND_API_KEY=
# Enable only after updating and testing the Windows worker client.
LOOX_WORKER_SIGNED_REQUESTS_REQUIRED=false
